Cell["Real Wishart Example", "Text",
 CellChangeTimes->{{3.9959575510752363`*^9, 3.99595755288284*^9}, {
  3.996205650942439*^9, 
  3.9962056519606943`*^9}},ExpressionUUID->"d50ff84e-c2ce-4044-b957-\
cd7d0fb9e929"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Define", " ", "a", " ", "function", " ", "to", " ", "generate",
     " ", "standard", " ", "Wishart", " ", "matrices"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateRealWishart", "[", 
     RowBox[{"n_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "X", "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"X", " ", "=", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"n", ",", " ", "p"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "p"}], ")"}], " ", "*", " ", 
        RowBox[{"X", " ", ".", " ", 
         RowBox[{"Transpose", "[", "X", "]"}]}]}]}]}], "\n", "]"}]}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"3.", " ", "Set", " ", "Dimensions", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "Keep", " ", "n", " ", "relatively", " ", "small", " ", "to", " ", 
        "start"}], ",", " ", 
       RowBox[{"e", ".", "g", "."}], ",", " ", 
       RowBox[{"50", " ", "or", " ", "100"}]}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "3.", " ", "Set", " ", "Dimensions", " ", "to", " ", "achieve", " ", 
      "\[Gamma]"}], " ", "=", " ", 
     RowBox[{"1", "/", "2"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", " ", "=", " ", "2000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", "n"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p", "=", "n"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"gamma", " ", "=", " ", 
      RowBox[{"1", "/", "2"}]}], ";", "\n", 
     RowBox[{"d", " ", "=", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"n", "/", "gamma"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"p", " ", "=", " ", "d"}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"gamma", " ", "=", " ", 
     RowBox[{"n", "/", 
      RowBox[{"(", 
       RowBox[{"d", "*", "p"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Generate", " ", "the", " ", "independent", " ", "Wishart", " ",
      "matrices"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Generating Wishart matrices...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"W", " ", "=", " ", 
     RowBox[{"GenerateRealWishart", "[", 
      RowBox[{"n", ",", " ", "d"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"V", " ", "=", " ", 
     RowBox[{"GenerateRealWishart", "[", 
      RowBox[{"n", ",", " ", "p"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "5.", " ", "Compute", " ", "the", " ", "scaled", " ", "Jury", " ", 
     "product"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Z", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "n"}], ")"}], " ", "*", " ", 
      RowBox[{"JuryProductFFT", "[", 
       RowBox[{"W", ",", " ", "V"}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"6.", " ", "Extract", " ", "Eigenvalues"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing eigenvalues...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"evals", " ", "=", " ", 
     RowBox[{"Eigenvalues", "[", "Z", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "7.", " ", "Plot", " ", "the", " ", "Empirical", " ", "Spectral", " ", 
     "Distribution"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "7.", " ", "Plot", " ", "the", " ", "Empirical", " ", "Spectral", " ", 
     "Distribution"}], " ", "*)"}], "\n", 
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{"Re", "[", "evals", "]"}], ",", " ", 
     RowBox[{"{", "0.05", "}"}], ",", " ", "\"\<PDF\>\"", ",", "\n", "  ", 
     RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Empirical Spectral Distribution of \
\\!\\(\\*FractionBox[\\(1\\), \\(n\\)]\\)(W \[Diamond] V)\>\"", ",", " ", 
        "14"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Eigenvalue\>\"", ",", " ", "\"\<Density\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"GrayLevel", "[", "0.2", "]"}], "]"}]}]}], "\n", 
    "]"}]}]}]], "Code",
 CellChangeTimes->{{3.992704401848507*^9, 3.992704408190597*^9}, {
   3.9927044428565063`*^9, 3.992704459512562*^9}, 3.992704509700829*^9, {

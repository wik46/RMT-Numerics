Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Old", " ", "Implementation", " ", "because", " ", "its", " ", "slow"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"Clear", "[", "JuryProduct", "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "Jury", " ", "Product", " ", "with",
      " ", "a", " ", "Progress", " ", "Tracker", " ", "for", " ", 
     "Rectangular", " ", "Matrices"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"JuryProduct", "[", 
     RowBox[{"A_", ",", " ", "B_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rows", ",", " ", "cols", ",", " ", "res", ",", " ", "i", ",", " ", 
        "j"}], "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Get", " ", "dimensions"}], ",", " ", 
        RowBox[{"ensuring", " ", "we", " ", 
         RowBox[{"don", "'"}], "t", " ", "exceed", " ", "the", " ", "bounds", 
         " ", "of", " ", "either", " ", "matrix"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"rows", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"Length", "[", "A", "]"}], ",", " ", 
          RowBox[{"Length", "[", "B", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"cols", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"A", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Length", "[", 
           RowBox[{"B", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ",
        "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{"Pre", "-", 
         RowBox[{
         "allocate", " ", "with", " ", "complex", " ", "0.0", " ", "to", " ", 
          "prevent", " ", "performance", " ", "loss", " ", "from", " ", 
          "array", " ", "unpacking"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.0", " ", "+", " ", 
           RowBox[{"0.0", " ", "I"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rows", ",", " ", "cols"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Monitor", " ", "displays", " ", "a", " ", "dynamic", " ", "progress",
          " ", "bar", " ", "during", " ", "evaluation"}], " ", "*)"}], "\n", 
       "  ", 
       RowBox[{"Monitor", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Do", "[", "\n", "      ", 
          RowBox[{
           RowBox[{"Do", "[", "\n", "        ", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"Fast", " ", "vectorized", " ", 
               RowBox[{"computation", ":", " ", "slice"}]}], ",", " ", 
              RowBox[{"reverse", " ", "B"}], ",", " ", "multiply", ",", " ", 
              RowBox[{"and", " ", "sum"}]}], " ", "*)"}], "\n", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"res", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", " ", "j"}], "]"}], "]"}], " ", "=", " ", 
              RowBox[{"Total", "[", "\n", "          ", 
               RowBox[{
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"1", " ", ";;", " ", "i"}], ",", " ", 
                    RowBox[{"1", " ", ";;", " ", "j"}]}], "]"}], "]"}], " ", "*",
                  " ", 
                 RowBox[{"Reverse", "[", 
                  RowBox[{
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"1", " ", ";;", " ", "i"}], ",", " ", 
                    RowBox[{"1", " ", ";;", " ", "j"}]}], "]"}], "]"}], ",", 
                   " ", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ",", "\n",
                 "          ", "2"}], "\n", "        ", "]"}]}], ",", "\n", 
             "        ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "1", ",", " ", "cols"}], "}"}]}], "\n", 
            "      ", "]"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", "rows"}], "}"}]}], "\n", 
          "    ", "]"}], ",", "\n", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Computing Jury Product: \>\"", ",", " ", 
            RowBox[{"ProgressIndicator", "[", 
             RowBox[{"i", ",", " ", 
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "rows"}], "}"}]}], "]"}], ",", 
            " ", "\"\< (Row \>\"", ",", " ", "i", ",", " ", "\"\< of \>\"", ",",
             " ", "rows", ",", " ", "\"\<)\>\""}], "}"}], "]"}]}], "\n", "  ",
         "]"}], ";", "\n", "  ", "\n", "  ", "res"}]}], "\n", "]"}]}], 

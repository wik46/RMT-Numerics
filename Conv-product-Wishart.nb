Cell[CellGroupData[{
Cell["Convolution of two matrices", "Title",
 CellChangeTimes->{{3.992681361052496*^9, 3.992681373843512*^9}, {
   3.99605540494587*^9, 3.996055411833086*^9}, {3.996205300256453*^9, 
   3.996205307480072*^9}, 
   3.996205689760923*^9},ExpressionUUID->"bb55a61b-5aab-4155-b453-\
baaa297b5d6b"],

Cell["Faster Implementation using FFT via ListConvolve", "Text",
 CellChangeTimes->{{3.996055426617282*^9, 
  3.996055448782941*^9}},ExpressionUUID->"e22ba23b-9939-4eb6-9595-\
91240d4c622c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Optimized", " ", "Conv", " ", "Product", " ", 
     RowBox[{"(", 
      RowBox[{
      "Replaces", " ", "the", " ", "nested", " ", "Do", " ", "loops", " ", 
       "usinf", " ", "FFT"}], ")"}]}], ",", " ", 
    RowBox[{
    "see", " ", "end", " ", "of", " ", "script", " ", "for", " ", 
     "examples"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"JuryProductFFT", "[", 
    RowBox[{"A_", ",", " ", "B_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ListConvolve", "[", 
    RowBox[{"A", ",", " ", "B", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "0"}], "]"}]}]}]], "Code",\

 CellChangeTimes->{
  3.996055472636827*^9, {3.9960613899375257`*^9, 3.9960613903527107`*^9}, {
   3.996205316259838*^9, 3.996205336777131*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"412c0ae8-ece4-45b9-9bb1-17071b1e4fc5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Example", " ", "2"}], ":", " ", 
    RowBox[{"3", "x3", " ", "matrices"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"8", ",", "9", ",", "10", ",", "11"}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"B", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"10", ",", "11", ",", "12", ",", "13"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"14", ",", "15", ",", "16", ",", "17"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"18", ",", "19", ",", "20", ",", "21"}], "}"}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"MatrixForm", "[", 
      RowBox[{"JuryProduct", "[", 
       RowBox[{"A", ",", "B"}], "]"}], "]"}], "  ", "Naive", " ", 
     "implementation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<J(\>\"", ",", 
      RowBox[{"MatrixForm", "[", "A", "]"}], ",", "\"\<, \>\"", ",", 
      RowBox[{"MatrixForm", "[", "B", "]"}], ",", "\"\<) = \>\"", ",", 
      RowBox[{"MatrixForm", "[", 
       RowBox[{"JuryProductFFT", "[", 
        RowBox[{"A", ",", "B"}], "]"}], "]"}]}], "]"}], ";"}]}]}]], "Code",
 CellChangeTimes->{{3.996055431138281*^9, 3.9960554374471416`*^9}, {
  3.996055482268567*^9, 3.996055501576713*^9}, {3.9962053484928093`*^9, 

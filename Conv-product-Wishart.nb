Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Define", " ", "a", " ", "function", " ", "to", " ", "generate",
     " ", "standard", " ", "Wishart", " ", "matrices"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateComplexWishart", "[", 
     RowBox[{"n_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "X", "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"FIXED", ":", " ", 
        RowBox[{
         RowBox[{"Added", " ", "'"}], "I", " ", "*", "'", " ", "to", " ", 
         "properly", " ", "generate", " ", "a", " ", "complex", " ", 
         "Gaussian", " ", "matrix"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{
       RowBox[{"X", " ", "=", " ", 
        RowBox[{
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "p"}], "}"}]}], "]"}], " ", "+", " ", "\n",
          "      ", 
         RowBox[{"I", " ", "*", " ", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"0", ",", " ", "1"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "p"}], "}"}]}], "]"}]}]}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "*", " ", "p"}], ")"}]}], ")"}], " ", "*", " ", 
        RowBox[{"X", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "X", "]"}]}]}]}]}], "\n", "]"}]}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "FFT", " ", "Jury", " ", "Product", 
     " ", 
     RowBox[{"(", 
      RowBox[{"From", " ", "our", " ", "earlier", " ", "fix"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"JuryProductFFT", "[", 
     RowBox[{"A_", ",", " ", "B_"}], "]"}], " ", ":=", " ", 
    RowBox[{"ListConvolve", "[", 
     RowBox[{"A", ",", " ", "B", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "0"}], "]"}]}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"3.", " ", "Set", " ", "Dimensions"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", " ", "=", " ", "2000"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"gammaTrue", " ", "=", " ", 
     RowBox[{"1", "/", "12"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d", " ", "=", " ", 
     RowBox[{"Floor", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"n", "/", "gammaTrue"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p", " ", "=", " ", "d"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gamma", " ", "=", " ", 
     RowBox[{"n", "/", 
      RowBox[{"(", 
       RowBox[{"d", "*", "p"}], ")"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Square", " ", "Case", " ", "\n", "p"}], " ", "=", " ", "n"}], ";",
      "\n", 
     RowBox[{"d", " ", "=", " ", "n"}], ";"}], "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Generate", " ", "the", " ", "independent", " ", "Wishart", " ",
      "matrices"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Generating Wishart matrices...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"W", " ", "=", " ", 
     RowBox[{"GenerateComplexWishart", "[", 
      RowBox[{"n", ",", " ", "d"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"V", " ", "=", " ", 
     RowBox[{"GenerateComplexWishart", "[", 
      RowBox[{"n", ",", " ", "p"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "5.", " ", "Compute", " ", "the", " ", "scaled", " ", "Jury", " ", 
     "product"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing Jury product...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Z", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "n"}], ")"}], " ", "*", " ", 
      RowBox[{"JuryProductFFT", "[", 
       RowBox[{"W", ",", " ", "V"}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"6.", " ", "Extract", " ", "Eigenvalues"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing eigenvalues...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"evals", " ", "=", " ", 
     RowBox[{"Eigenvalues", "[", "Z", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "7.", " ", "Plot", " ", "the", " ", "Empirical", " ", "Spectral", " ", 
     "Distribution", " ", "with", " ", "a", " ", "Parameter", " ", "Box"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Generating Plot...\>\"", "]"}], ";"}], "\n", 
   RowBox[{"Histogram", "[", 
    RowBox[{
     RowBox[{"Re", "[", "evals", "]"}], ",", " ", 
     RowBox[{"{", "0.05", "}"}], ",", " ", "\"\<PDF\>\"", ",", "\n", "  ", 
     RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Empirical Spectral Distribution of \
\\!\\(\\*FractionBox[\\(1\\), \\(n\\)]\\)(W \[Diamond] V)\>\"", ",", " ", 
        "14"}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Eigenvalue\>\"", ",", " ", "\"\<Density\>\""}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{"ChartStyle", " ", "->", " ", 
      RowBox[{"EdgeForm", "[", 
       RowBox[{"GrayLevel", "[", "0.2", "]"}], "]"}]}], ",", "\n", "  ", "\n",
      "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"--", 
         RowBox[{"-", " ", "ADDED"}]}], " ", "EPILOG", " ", "TO", " ", "PUT", 
        " ", "TEXT", " ", "INSIDE", " ", "THE", " ", 
        RowBox[{"FIGURE", " ", "--"}]}], "-"}], " ", "*)"}], "\n", "  ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"Inset", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"Framed", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", "\n", "        ", 
             RowBox[{
              RowBox[{"Style", "[", 
               
               RowBox[{"\"\<Dimensions & Parameters\>\"", ",", " ", "Bold", ",",
                 " ", "12"}], "]"}], ",", "\n", "        ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<N = \>\"", ",", " ", "n"}], "}"}], "]"}], ",", 
              "\n", "        ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<d = \>\"", ",", " ", "d"}], "}"}], "]"}], ",", 
